PORT=3000

# Base de datos MongoDB (local o Atlas). Obligatoria.
MONGO_URL=mongodb://localhost:27017/eventos_inscripciones

# Clave secreta para firmar el JWT (cambiar en produccion). Obligatoria.
JWT_SECRET=tu_clave_secreta_muy_larga_y_aleatoria

# Expiracion del JWT (ej: 1h, 24h, 7d)
JWT_EXPIRES_IN=1h

# Entorno de ejecucion: development | production
NODE_ENV=development

# ============================================
# Email (Nodemailer) - todas obligatorias si se envian notificaciones
# ============================================
# Host SMTP (ej: Gmail -> smtp.gmail.com, Mailtrap -> sandbox.smtp.mailtrap.io)
MAIL_HOST=smtp.gmail.com

# Puerto SMTP (465 para SSL, 587 para STARTTLS)
MAIL_PORT=587

# Usuario SMTP (tu direccion de email)
MAIL_USER=tu_email@gmail.com

# Password o App Password del proveedor SMTP
MAIL_PASS=tu_app_password

# Remitente de los correos
MAIL_FROM=tu_email@gmail.com