{
    "name": "control-cupos",
    "version": "1.0.0",
    "description": "Pre-entrega 8 - Plataforma de Eventos e Inscripciones con arquitectura en capas: DAO (acceso a Mongoose), Repository (capa de dominio), Service (lógica de negocio), Controller y DTOs que sanitizan las respuestas. Incluye autenticación JWT, control de cupos, inscripciones, cancelaciones y notificaciones por email",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "node --test"
    },
    "keywords": [
        "express",
        "nodejs",
        "passport",
        "jwt",
        "autenticacion",
        "mongodb",
        "mongoose",
        "bcrypt",
        "nodemailer",
        "api"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.9.4",
        "nodemailer": "^6.9.16",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0"
    },
    "devDependencies": {
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.0",
        "supertest": "^7.3.1"
    }
